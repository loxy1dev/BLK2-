# Secret used to cryptographically sign purchase keys.
SHOP_KEY_SECRET=generate-a-long-random-secret
# Secret protecting the admin verification/stock panel.
SHOP_ADMIN_SECRET=generate-another-long-random-secret
# Upstash Redis REST database (required for persistent stock + single-use orders).
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Optional Discord webhook for purchase logs.
DISCORD_SHOP_WEBHOOK=https://discord.com/api/webhooks/...
